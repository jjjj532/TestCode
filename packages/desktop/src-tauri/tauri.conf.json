{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TestCode",
  "version": "0.1.0",
  "identifier": "com.testcode.app",
  "build": {
  },
  "app": {
    "windows": [
      {
        "title": "TestCode",
