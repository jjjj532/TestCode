{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TestCode",
  "version": "0.1.0",
  "identifier": "com.testcode.app",
  "build": {
    "devtools": true,
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "",
    "frontendDist": "../tui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TestCode",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
